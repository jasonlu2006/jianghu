{
  "name": "jianghu",
  "private": true,
  "version": "0.1.0",
  "description": "AI-native interactive fiction for Murim / regression / cultivation worlds: deterministic world engine + AI narrator.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "play": "pnpm --filter @murim/cli play",
    "dev": "pnpm --filter @murim/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
